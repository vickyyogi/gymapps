# Copy to apps/web/.env.local
DATABASE_URL="postgresql://gymapps:gymapps@localhost:5432/gymapps?schema=public"

APP_VERSION="dev"

# Set true only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS="false"

# AI program generator. Leave the key or model empty to disable AI features.
# OPENCODE_GO_BASE_URL must include /v1, e.g. https://your-gateway.example/v1
AI_ENABLED="true"
AI_PROGRAM_ENABLED="true"
AI_CHAT_ENABLED="true"
AI_RECOMMENDATIONS_ENABLED="true"
OPENCODE_GO_API_KEY=""
OPENCODE_GO_BASE_URL=""
OPENCODE_GO_MODEL_MAIN=""
OPENCODE_GO_MODEL_FAST=""
# USD per 1M tokens. Cost = tokens * price / 1,000,000.
OPENCODE_GO_PRICE_MAIN_IN="0"
OPENCODE_GO_PRICE_MAIN_OUT="0"
OPENCODE_GO_PRICE_FAST_IN="0"
OPENCODE_GO_PRICE_FAST_OUT="0"
# Optional, default 45000.
# OPENCODE_GO_TIMEOUT_MS="45000"

# Export storage. Default: <cwd>/.exports
# EXPORT_DIR="/var/lib/gymapps/exports"
# EXPORT_SIGNING_SECRET="change-me"

# PDF renderer. playwright-core uses this Chrome binary.
CHROME_PATH="/usr/bin/google-chrome"
