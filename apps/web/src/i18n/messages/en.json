  "privacy": {
    "title": "Privacy Policy",
    "effectiveDate": "Effective date: October 20, 2026 · Version 1.0",
    "intro": "This Privacy Policy explains how GymApps collects, uses, stores, and protects your personal data in accordance with Indonesia Law No. 27 of 2022 on Personal Data Protection (UU PDP).",
    "section1Title": "1. Data We Collect",
    "section1Body": "We follow data minimization principles and collect only what is needed for the service: (a) Account data: email address, display name, hashed password (Argon2id), and preferences (language, units, timezone); (b) Fitness data: training profile, workout history, sets, personal records, body metrics, and training notes.",
    "section2Title": "2. AI Processing & PII Redaction",
    "section2Body": "When you use the AI Program Generator or Coach Chat, your email address and real name are redacted before context is sent to the AI model provider. Your training data is never used to train third-party AI models.",
    "section3Title": "3. Data Storage & Retention",
    "section3Body": "Export files (CSV/JSON/PDF) are stored behind signed URLs and expire automatically after 7 days. When you request account deletion, your account enters a 30-day soft-delete grace period before all personal data and export files are permanently deleted (hard-delete).",
    "section4Title": "4. Your Data Subject Rights (UU PDP)",
    "section4Body": "You have the right to access, update, export (data portability in CSV/JSON formats under Exports), withdraw communication consent, and delete your account and all associated data at any time from Settings.",
    "backToApp": "Back"
  },
  "terms": {
    "title": "Terms of Service",
    "effectiveDate": "Effective date: October 20, 2026 · Version 1.0",
    "intro": "By registering for and using GymApps, you agree to the following Terms of Service.",
    "section1Title": "1. Minimum Age Requirement (16 Years)",
    "section1Body": "GymApps is intended for users who are at least 16 years old. By creating an account, you represent and warrant that you are at least 16 years of age.",
    "section2Title": "2. Medical Disclaimer & Training Safety",
    "section2Body": "GymApps and its AI Coach / AI Program Generator are not medical professionals and do not provide medical diagnosis, prescriptions, or injury rehabilitation therapy. All AI programs and recommendations are general fitness suggestions and not a substitute for a certified coach or physician. Stop exercising immediately if you feel sharp pain, dizziness, or medical distress.",
    "section3Title": "3. Account Security & Fair Use",
    "section3Body": "You are responsible for keeping your account password confidential. Automated abuse that circumvents rate limits or quotas may result in access restrictions.",
    "section4Title": "4. Data Ownership & Deletion",
    "section4Body": "You own the training data you log. You can download a full copy of your data at any time or delete your account from the Settings page.",
    "backToApp": "Back"
  }
}
