{
  "name": "gymapps",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gymapps/web",
    "build": "npm run build -w @gymapps/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:phase3": "node scripts/phase3-e2e.mjs",
    "test:phase4": "node scripts/phase4-e2e.mjs",
    "test:phase5": "node scripts/phase5-e2e.mjs",
    "gen:api": "npm run gen:api -w @gymapps/shared",
    "db:generate": "npm run db:generate -w @gymapps/db",
    "db:migrate": "npm run db:migrate -w @gymapps/db",
    "db:seed": "npm run db:seed -w @gymapps/db",
    "setup": "npm install && npm run gen:api && npm run db:generate",
    "test:phase6": "node scripts/phase6-e2e.mjs",
    "test:phase7": "node scripts/phase7-e2e.mjs",
    "test:phase8": "npm run build && node scripts/phase8-e2e.mjs",
    "test:load": "node scripts/phase8-load.mjs",
    "test:backup": "node scripts/phase8-backup.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0"
  }
}
