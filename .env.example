# Copy to packages/db/.env and apps/web/.env.local (Next.js does not read the repo root .env)
DATABASE_URL="postgresql://gymapps:gymapps@localhost:5432/gymapps?schema=public"

APP_VERSION="dev"

# Email verifikasi + reset password (REST kompatibel Resend). Kosong = fitur nonaktif.
EMAIL_API_KEY=""
EMAIL_FROM="GymApps <no-reply@example.com>"
# EMAIL_PROVIDER_BASE_URL="https://api.resend.com"
# APP_BASE_URL="http://localhost:3000"

# Object storage untuk export/PDF. Kosong = disk lokal (EXPORT_DIR di apps/web).
# S3_BUCKET=""
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Set true only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS="false"
